{
  "weights": {
    "technical": 15,
    "metadata": 5,
    "context": 80
  },
  "criteria": {
    "T1": {
      "threshold_khz": 16,
      "severe_khz": 14
    },
    "T2": {
      "crest_db_threshold": 8,
      "lra_lu_threshold": 3
    },
    "M1": {
      "patterns": [
        "suno",
        "udio",
        "stable audio",
        "riffusion",
        "musicgen",
        "aiva",
        "soundraw",
        "boomy",
        "ecrett",
        "mubert",
        "loudly"
      ],
      "whitelist": [
        "promo-cloud",
        "konkah engine"
      ]
    },
    "M4": {
      "acronym_artist_max_len": 5,
      "suffixes": [
        "xtd",
        "extended",
        "remix",
        "vocal",
        "instrumental",
        "radio edit"
      ]
    }
  },
  "metadata_sources": [
    "musicbrainz",
    "discogs",
    "soundcloud"
  ],
  "request_timeout_s": 10,
  "retry_attempts": 3,
  "community_db": {
    "enabled": true,
    "url": "https://raw.githubusercontent.com/holgerkampffmeyer2/ai-artists-db/main/known_ai_artists.json",
    "ttl_hours": 24,
    "fuzzy_enabled": false,
    "fuzzy_threshold": 0.9,
    "evidence": {
      "check": false,
      "retention_days": 30
    }
  },
  "llm_judge": {
    "enabled": false,
    "backend": "openrouter",
    "model": "openai/gpt-4o-mini",
    "api_key_env": "OPENROUTER_API_KEY",
    "timeout_s": 30,
    "temperature": 0.1,
    "max_tokens": 1500,
    "prompt_template": "builtin_v1"
  },
  "db_suggest": {
    "enabled": false,
    "min_ai_probability": 0.6
  }
}
